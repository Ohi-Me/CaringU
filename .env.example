# Copy to .env (never commit .env). All values are optional.
PORT=8787
DB_PATH=data/carecircle.db

# Agent: "bedrock" forces Amazon Bedrock, "rules" forces the deterministic planner.
# If unset, Bedrock is used when AWS credentials are present in the environment.
AGENT_MODE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# Named profile for a least-privilege dev identity (see README "Use Amazon Bedrock").
# AWS_PROFILE=carecircle-dev
# Use `aws configure` / an IAM role rather than putting keys here.
