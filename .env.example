# Copy to .env (never commit .env). All values are optional.
PORT=8787
DB_PATH=data/carecircle.db

# Agent: "bedrock" forces Amazon Bedrock, "rules" forces the deterministic planner.
# If unset, Bedrock is used when AWS credentials are present in the environment.
AGENT_MODE=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# Named profile for a least-privilege dev identity (see README "Use Amazon Bedrock").
# AWS_PROFILE=carecircle-dev
# Use `aws configure` / an IAM role rather than putting keys here.

# NVIDIA Nemotron on Nebius Token Factory (AGENT_MODE=nebius). Ultra writes the weekly review; VL reads words in Scam Lens photos.
# NEBIUS_API_KEY=
# NEBIUS_VISION=off            # turn off the VL reading in Scam Lens

# Safe Pay: PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Without these, nothing is paid.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_PAYEE_PHARMACY=        # sandbox business email that receives pharmacy payments (default: the app's own merchant account)
# PUBLIC_URL=http://localhost:8787   # where PayPal sends people back after approving
# PAY_DAILY_LIMIT=50
