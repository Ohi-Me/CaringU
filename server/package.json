{
  "name": "carecircle-server",
  "version": "1.0.0",
  "description": "CareCircle MCP server and agent",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "node --env-file-if-exists=../.env --import tsx scripts/eval.ts",
    "heldout": "node --env-file-if-exists=../.env --import tsx scripts/heldout.ts",
    "vision": "node scripts/start-vision.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1148.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^4.6.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
